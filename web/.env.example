# ---------------------------------------------------------------------------
# AgentRecheck web app. Copy to .env.local and fill in.
#
# With NOTHING set, the app runs in local demo mode: an embedded Postgres
# (PGlite, stored in .data/), a seeded demo project, and a demo sign-in that
# does not send email. Set the values below to run it for real.
# ---------------------------------------------------------------------------

# Postgres connection string. For Supabase use the "Transaction pooler" URI
# (Project Settings → Database → Connection string).
DATABASE_URL=

# Supabase Auth (magic link). Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public URL of this app, used in links returned by the API (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shown on the landing page.
NEXT_PUBLIC_GITHUB_URL=https://github.com/your-org/agentrecheck
